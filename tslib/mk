#!/bin/bash

source ../mktools

mk_setenv $1
mk_setdefaults $build

mk_printenv "tslib"

mk_createfolders $rootdir

mk_cleanfolders $rootdir

cd $srcdir
$runiix compile \
	$buildopts \
	ini.c \
	utils.c \
	tsarray.c \
	tslist.c \
	tsstring.c \
	tsmem.c \
	nucrc16.c

mk_movebin $srcdir $bindir

cd $bindir
$runiix makelib \
	$makelibopts \
	$libdir/tslib \
	+tsarray.a \
	+tslist.a \
	+ini.a \
	+utils.a \
	+tsstring.a \
	+tsmem.a \
	+nucrc16.a
	
	
cp $srcdir/*.h $libdir

cd $rootdir






